{
  "name": "dsh-plugin-memo-calendar",
  "version": "1.0.0",
  "private": true,
  "description": "DSH 备忘录：右侧栏笔记面板，支持搜索、置顶、自动保存，数据存放在本机 DSH 目录",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "memo",
    "notes",
    "calendar"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "license": "MIT"
}
