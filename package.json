{
  "name": "dsh-plugin-memo-calendar",
  "version": "2.0.0",
  "private": true,
  "description": "A calendar memo panel for DeepSeek Harness: one local, auto-saved memo for every day.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "memo",
    "calendar",
    "journal",
    "notes"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZSj925/dsh-plugin-memo-calendar.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
